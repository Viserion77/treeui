// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {}
	},
	"runArgs": [
		"--net=host"
	],
	// WSL2 exhausts the inotify watcher limit and crashes Vite/Storybook with ENOSPC.
	"postStartCommand": "sudo sysctl -w fs.inotify.max_user_watches=2097152 fs.inotify.max_user_instances=16384 || true"
}
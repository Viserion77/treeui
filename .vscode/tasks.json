{
  "version": "2.0.0",
  "tasks": [
    // ── Run locally ─────────────────────────────────────────────────────
    {
      "label": "Dev: Storybook Vue (6006)",
      "detail": "Builds the packages and starts the @treeui/docs Storybook at http://localhost:6006",
      "type": "shell",
      "command": "pnpm dev",
      "icon": { "id": "book", "color": "terminal.ansiGreen" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Dev: Storybook React (6007)",
      "detail": "Starts the @treeui/docs-react Storybook at http://localhost:6007 (build the packages first)",
      "type": "shell",
      "command": "pnpm --filter @treeui/docs-react docs:dev",
      "icon": { "id": "book", "color": "terminal.ansiCyan" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Dev: Landing",
      "detail": "Starts the landing page (@treeui/landing) with Vite",
      "type": "shell",
      "command": "pnpm --filter @treeui/landing dev",
      "icon": { "id": "globe", "color": "terminal.ansiMagenta" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Dev: Example Vue (6008)",
      "detail": "Builds the packages and starts dashboard-vue (@treeui/example-dashboard-vue) at http://localhost:6008",
      "type": "shell",
      "command": "pnpm example:vue:dev",
      "icon": { "id": "dashboard", "color": "terminal.ansiGreen" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Dev: Example React (6009)",
      "detail": "Builds the packages and starts dashboard-react (@treeui/example-dashboard-react) at http://localhost:6009",
      "type": "shell",
      "command": "pnpm example:react:dev",
      "icon": { "id": "dashboard", "color": "terminal.ansiCyan" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "Build: packages",
      "detail": "Builds tokens → utils → icons → vue → react → mcp",
      "type": "shell",
      "command": "pnpm build:packages",
      "icon": { "id": "package", "color": "terminal.ansiBlue" },
      "problemMatcher": [],
      "presentation": { "panel": "shared", "clear": true }
    },

    // ── Validate before committing ──────────────────────────────────────
    {
      "label": "Lint",
      "detail": "ESLint with zero warnings",
      "type": "shell",
      "command": "pnpm lint",
      "icon": { "id": "search", "color": "terminal.ansiYellow" },
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "panel": "shared", "clear": true }
    },
    {
      "label": "Typecheck",
      "detail": "TypeScript strict mode across every package and app",
      "type": "shell",
      "command": "pnpm typecheck",
      "icon": { "id": "symbol-type-parameter", "color": "terminal.ansiBlue" },
      "problemMatcher": ["$tsc"],
      "presentation": { "panel": "shared", "clear": true }
    },
    {
      "label": "Test: unit",
      "detail": "Vitest with coverage",
      "type": "shell",
      "command": "pnpm test",
      "icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "panel": "shared", "clear": true }
    },
    {
      "label": "Test: e2e",
      "detail": "Playwright — run it if interaction or a11y changed",
      "type": "shell",
      "command": "pnpm test:e2e",
      "icon": { "id": "browser", "color": "terminal.ansiCyan" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "panel": "shared", "clear": true }
    },
    {
      "label": "Build: full",
      "detail": "Builds the packages + Storybook",
      "type": "shell",
      "command": "pnpm build",
      "icon": { "id": "tools", "color": "terminal.ansiBlue" },
      "problemMatcher": [],
      "presentation": { "panel": "shared", "clear": true }
    },
    {
      "label": "Validate (pre-commit)",
      "detail": "Quality gate: lint → typecheck → test → build",
      "type": "shell",
      "command": "echo 'All green — ready to commit!'",
      "icon": { "id": "verified-filled", "color": "terminal.ansiGreen" },
      "dependsOrder": "sequence",
      "dependsOn": ["Lint", "Typecheck", "Test: unit", "Build: full"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "panel": "shared" }
    }
  ]
}

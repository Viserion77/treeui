{
  "name": "@treeui/icons",
  "version": "0.18.0",
  "description": "Extensible icon registry for TreeUI, with a curated built-in catalog.",
  "license": "MIT",
  "author": "TreeUI",
  "homepage": "https://viserion77.github.io/treeui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viserion77/treeui.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/Viserion77/treeui/issues"
  },
  "keywords": [
    "treeui",
    "icons",
    "svg",
    "icon-registry",
    "design-system"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec rimraf dist && pnpm exec tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  }
}

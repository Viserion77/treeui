{
  "name": "@treeui/react",
  "version": "0.3.2",
  "description": "React component package for TreeUI.",
  "license": "MIT",
  "author": "TreeUI",
  "homepage": "https://viserion77.github.io/treeui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viserion77/treeui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Viserion77/treeui/issues"
  },
  "keywords": [
    "treeui",
    "react",
    "component-library",
    "design-system",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec rimraf dist && pnpm exec tsup && node scripts/copy-styles.mjs",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@treeui/tokens": "workspace:*",
    "@treeui/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}

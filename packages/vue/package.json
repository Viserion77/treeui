{
  "name": "@treeui/vue",
  "version": "0.27.0",
  "description": "Vue 3 component package for TreeUI.",
  "license": "MIT",
  "author": "TreeUI",
  "homepage": "https://viserion77.github.io/treeui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viserion77/treeui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Viserion77/treeui/issues"
  },
  "keywords": [
    "treeui",
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec rimraf dist && pnpm exec vite build",
    "typecheck": "pnpm exec vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@treeui/icons": "workspace:*",
    "@treeui/tokens": "workspace:*",
    "@treeui/utils": "workspace:*"
  }
}
